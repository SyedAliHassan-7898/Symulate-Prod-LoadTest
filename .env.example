# Symulate load / browser validation environment
ENV=dev

API_URL=https://api.symulate.weuno.co/dev/api
SUPER_ADMIN_URL=https://superadmin.symulate-dev.weuno.co
CLIENT_ADMIN_URL=https://client-admin.symulate-dev.weuno.co
CANDIDATE_URL=https://symulate-ai-dev.weuno.co
ACTIVITY_IMAGE_URL=https://symulate-ai-dev.weuno.co/favicon.ico

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional pre-provisioned candidate used by `npm run smoke` when
# CANDIDATE_EXECUTION_SOURCE=preprovisioned|both|auto (smoke only), and by the
# focused candidate-load commands.
CANDIDATE_EMAIL=
CANDIDATE_PASSWORD=
CANDIDATE_DEFAULT_PASSWORD=
CLIENT_ADMIN_DEFAULT_PASSWORD=
ASSESSMENT_CANDIDATE_ID=
ASSESSMENT_PROJECT_ID=
ASSESSMENT_BOOKING_ID=
ASSESSMENT_BOOKING_START_AT=

# Add one set per VU for focused candidate-load tests.
# CANDIDATE_EMAIL_2=
# CANDIDATE_PASSWORD_2=
# ASSESSMENT_CANDIDATE_ID_2=
# ASSESSMENT_PROJECT_ID_2=
# ASSESSMENT_BOOKING_ID_2=
# ASSESSMENT_BOOKING_START_AT_2=

# -----------------------------------------------------------------------------
# Scenario and load controls
# -----------------------------------------------------------------------------
# Supported scenarios:
# full | role-play-only | interview-only | case-only | situation-only |
# board-meeting-only | welcome-only
# Focused assessment scenarios automatically include exactly one Welcome
# activity because the backend requires Welcome in every stage.
SCENARIO=full
LOAD_MODE=smoke

# LOAD_VUS=10 + LOAD_ITERATIONS_PER_VU=1 creates exactly 10 isolated client /
# project flows in load mode. Smoke mode intentionally uses one VU.
LOAD_VUS=10
LOAD_ITERATIONS_PER_VU=1
LOAD_MAX_DURATION=30m

# Performance gate profile:
# auto       -> strict in smoke mode, concurrency-aware baseline in load mode
# strict     -> p95/p99 regression gate suitable for low-concurrency runs
# baseline   -> keeps load latency bounded without treating dev-environment
#               setup queueing as a functional failure
# functional -> only correctness/request-failure thresholds; latency still reports
PERFORMANCE_PROFILE=auto

# Every newly-created managed project provisions this many candidates from
# data/candidates.csv. The repository contains exactly 20 seed candidates.
NUM_CANDIDATES=20

# SINGLE SOURCE OF TRUTH for the managed project lifecycle:
# true  -> send project invitations, require ACTIVE state, then candidate
#          activity execution may start.
# false -> provisioning only. Candidates are imported/assigned, but no candidate
#          portal login, booking, transcript socket, or COMPLETED activity call
#          is allowed in `npm run smoke`.
SEND_PROJECT_INVITATIONS=true
SEND_CLIENT_EMAIL=true

# The specialized e2e:anam:* and e2e:no-anum:full npm commands explicitly
# enable invitations for their isolated E2E project because a browser/session
# test cannot run against a provisioning-only project. This does not modify .env
# and does not affect smoke/load commands.

# Candidate execution after a successful managed project activation:
# auto            -> smoke: generated + pre-provisioned when the hardcoded
#                    candidate is fully configured; load: generated only
# generated       -> first candidate from the newly-created project
# preprovisioned  -> CANDIDATE_*/ASSESSMENT_* candidate only
# both            -> generated candidate + pre-provisioned candidate
# none            -> do not execute candidates even after project activation
CANDIDATE_EXECUTION_SOURCE=auto

INCLUDE_PROJECT_REVIEW=false
ALLOW_SHARED_CANDIDATES=false
ALLOW_SHARED_REVIEW_TARGETS=false

# Candidate booking/session propagation controls.
ENFORCE_BOOKING=true
BOOKING_START_SETTLE_MS=3000
SESSION_START_RETRY_ATTEMPTS=3
SESSION_START_RETRY_DELAY_MS=2500

# -----------------------------------------------------------------------------
# Anam validation / resilience modes
# -----------------------------------------------------------------------------
# disabled   = Talent Intelligence OFF; browser must make zero Anam calls
# healthy    = Talent Intelligence ON; Anam remains reachable
# outage503  = Anam starts healthy; after initial engine+metrics success,
#              subsequent Anam HTTP calls receive 503 and active WebSocket is
#              interrupted
# network    = same timing as outage503, but subsequent HTTP is network-aborted
ANAM_MODE=disabled
ANUM_API_ENABLED=false

SIMULATE_ANAM_MID_SESSION_OUTAGE=false
ANAM_OUTAGE_MODE=503
ANAM_OUTAGE_AUTO_RECOVER=true
ANAM_OUTAGE_RECOVER_AFTER_MS=15000
OUTAGE_AUTO_COMPLETE_ACTIVITY=true
ANAM_REQUIRE_POST_RECOVERY_RETRY=false

# Browser controls
HEADLESS=true
# fake   = deterministic fake microphone (recommended for automated E2E)
# system = use host microphone; use HEADLESS=false
# disabled = no microphone permission
PLAYWRIGHT_MICROPHONE_MODE=fake
STEP_TIMEOUT_MS=20000
TIMER_MAX_WAIT_MIN=15
MAX_ACTIVITIES=10

# Optional review configuration
PROJECT_REVIEW_PROJECT_ID=
PROJECT_REVIEW_CANDIDATE_ID=
PROJECT_REVIEW_CANDIDATE_LIMIT=1
PROJECT_REVIEW_REASON=good
PROJECT_REVIEW_SCORE=
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=
CLIENT_ADMIN_USER_ID=

# Runner diagnostics
RUNNER_VERBOSE=false
