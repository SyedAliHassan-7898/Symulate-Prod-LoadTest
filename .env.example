# =============================================================================
# Symulate Load Testing — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your target environment.
# NEVER commit .env to source control.
#
# Quick-start for different run sizes:
#
#   Smoke (1 VU, dev):
#     LOAD_MODE=smoke  ENV_PROFILE=dev  (no other changes needed)
#
#   Light load (10 VUs, staging):
#     LOAD_MODE=load  LOAD_VUS=10  ENV_PROFILE=staging
#     LOAD_TEST_ADMIN_EMAIL=...  LOAD_TEST_ADMIN_PASSWORD=...
#
#   Heavy load (100 VUs, staging/prod-like):
#     LOAD_MODE=load  LOAD_VUS=100  ENV_PROFILE=staging  (or production)
#     LOAD_TEST_ADMIN_EMAIL=...  LOAD_TEST_ADMIN_PASSWORD=...
#     LOAD_SCALE is auto-computed from LOAD_VUS — no manual edit needed.
# =============================================================================

ENV=dev

API_URL=https://api.symulate.weuno.co/dev/api
SUPER_ADMIN_URL=https://superadmin.symulate-dev.weuno.co
CLIENT_ADMIN_URL=https://client-admin.symulate-dev.weuno.co
CANDIDATE_URL=https://symulate-ai-dev.weuno.co
ACTIVITY_IMAGE_URL=https://d5uk4ljnw67gt.cloudfront.net/create_task/images-2026-10-05T13-01-34-507Z-b36a8431-759a-4605-b75a-6e1a92b7980b.jpg

# -----------------------------------------------------------------------------
# Credentials — Real Super Admin (teardown + impersonation only)
# -----------------------------------------------------------------------------
# Used ONLY by:
#   - teardown() to delete resources after a run
#   - impersonateClientAdmin() inside each VU
# Do NOT use these for the VU provisioning loop — use LOAD_TEST_ADMIN_* below.
SUPER_ADMIN_EMAIL=superadmin@yopmail.com
SUPER_ADMIN_PASSWORD=Test@123

# -----------------------------------------------------------------------------
# Credentials — Dedicated Load Test Admin (RECOMMENDED for staging/production)
# -----------------------------------------------------------------------------
# Create a separate Super Admin account with the same privileges as the real
# Super Admin, used exclusively for load test VU provisioning. This prevents
# 100+ concurrent logins from hammering your primary admin account and avoids
# session-invalidation / rate-limit issues on auth endpoints.
#
# If left empty, the suite falls back to SUPER_ADMIN_EMAIL/PASSWORD with a
# runtime warning in the k6 output. For dev/smoke runs the fallback is fine;
# for staging/production runs always set these.
LOAD_TEST_ADMIN_EMAIL=
LOAD_TEST_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Default candidate / client admin passwords
# -----------------------------------------------------------------------------
CANDIDATE_DEFAULT_PASSWORD=
CLIENT_ADMIN_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# Pre-provisioned candidate (optional)
# Used by `npm run smoke` when CANDIDATE_EXECUTION_SOURCE=preprovisioned|both|auto
# and by focused candidate-load commands.
# -----------------------------------------------------------------------------
CANDIDATE_EMAIL=Tester@yopmail.com
CANDIDATE_PASSWORD=Test@123
# Optional pre-provisioned candidate invitation href. Generated candidates use
# the rendered invitation email href returned by the invitation/email provider.
CANDIDATE_INVITATION_HREF=
ASSESSMENT_CANDIDATE_ID=052d6580-0475-4942-a310-70fd567382f5
ASSESSMENT_PROJECT_ID=8c29b8d2-fd99-4009-a150-dfdc58ceb498
ASSESSMENT_BOOKING_ID=
ASSESSMENT_BOOKING_START_AT=

# Add one set per VU for focused candidate-load tests (up to 100 supported).
# CANDIDATE_EMAIL_2=
# CANDIDATE_PASSWORD_2=
# ASSESSMENT_CANDIDATE_ID_2=
# ASSESSMENT_PROJECT_ID_2=
# ASSESSMENT_BOOKING_ID_2=
# ASSESSMENT_BOOKING_START_AT_2=

# =============================================================================
# Environment profile & dynamic scaling
# =============================================================================

# ENV_PROFILE — controls threshold tightness and is used by scaleMs() helpers.
#
#   dev         → baseline thresholds (loose p99; tolerates dev-env queueing)
#   staging     → standard thresholds (intermediate; pre-prod gate)
#   production  → strict thresholds  (tight p95/p99 SLOs; CI regression gate)
#
# Default: dev
ENV_PROFILE=dev

# LOAD_SCALE — explicit concurrency multiplier for timing and threshold scaling.
#
# AUTO-COMPUTED from LOAD_VUS when not set (recommended — leave blank):
#   1–9 VUs   → scale 1   10–24 VUs → scale 2   25–49 VUs → scale 3
#   50–99 VUs → scale 4   100+ VUs  → scale 5
#
# Set explicitly ONLY if you need to override the auto-computed value, e.g.
# to test stricter thresholds on a small VU count: LOAD_SCALE=1
# Leave blank for normal use.
LOAD_SCALE=

# SOCKET_MAX_CONCURRENT — per-VU soft cap on simultaneous Socket.IO connections.
# 0 = unlimited (default). Set to 2–3 to prevent a single VU from opening many
# sockets in rapid succession during multi-activity candidate runs.
SOCKET_MAX_CONCURRENT=0

# =============================================================================
# Scenario and load controls
# =============================================================================

# Supported scenarios:
#   full | role-play-only | interview-only | case-only | situation-only |
#   board-meeting-only | welcome-only
# Focused assessment scenarios automatically include exactly one Welcome
# activity because the backend requires Welcome in every stage.
SCENARIO=full

# LOAD_MODE — smoke uses 1 VU/1 iteration; load uses LOAD_VUS VUs.
LOAD_MODE=smoke

# LOAD_VUS — number of concurrent VUs in load mode.
# LOAD_VUS=N creates exactly N independent client/project/candidate sets.
# MAX_DURATION and GRACEFUL_STOP are auto-scaled from this value — you do
# not need to update them manually when changing LOAD_VUS.
LOAD_VUS=10
LOAD_ITERATIONS_PER_VU=1

# LOAD_MAX_DURATION — override the auto-computed max duration if needed.
# Auto-computed: 20m + (LOAD_SCALE-1)*5m, capped at 60m (load-client-project)
#                30m + (LOAD_SCALE-1)*8m, capped at 90m (smoke)
# Leave blank to use the auto-computed value.
LOAD_MAX_DURATION=

# PERFORMANCE_PROFILE — overrides the ENV_PROFILE threshold selection.
#   auto       → resolves via ENV_PROFILE first, then LOAD_MODE heuristic
#   strict     → tight p95/p99 gate (same as ENV_PROFILE=production)
#   standard   → intermediate gate (same as ENV_PROFILE=staging)
#   baseline   → loose gate (same as ENV_PROFILE=dev)
#   functional → correctness only; no latency thresholds
# Default: auto (recommended — let ENV_PROFILE drive the selection)
PERFORMANCE_PROFILE=auto

# Every newly-created managed project provisions this many candidates from
# data/candidates.csv. The repository contains exactly 20 seed candidates.
NUM_CANDIDATES=20

# =============================================================================
# Safety flags — email and invitation dispatch
# =============================================================================
# IMPORTANT: Both flags default to FALSE in code (changed from the original
# TRUE default). You must explicitly set them to true to dispatch real emails.
# Always double-check these before running against staging or production.

# SEND_PROJECT_INVITATIONS:
#   false → provisioning only (candidates are assigned but no portal login,
#           booking, transcript socket, or COMPLETED activity call is allowed)
#   true  → sends invitation emails, activates the project, enables candidate
#           activity execution
# WARNING: setting true on a large load run will dispatch N×NUM_CANDIDATES
# invitation emails to your email provider.
SEND_PROJECT_INVITATIONS=true

# SEND_CLIENT_EMAIL:
#   false → suppresses onboarding emails when new client orgs are created
#   true  → sends onboarding emails (counts against your email quota)
# WARNING: 100 VUs with true = 100+ onboarding emails dispatched.
SEND_CLIENT_EMAIL=false

# CANDIDATE_EXECUTION_SOURCE — which candidates run activities after provisioning.
#   auto            → smoke: generated+preprovisioned when hardcoded candidate
#                     is fully configured; load: generated only
#   generated       → first candidate from the newly-created project
#   preprovisioned  → CANDIDATE_*/ASSESSMENT_* candidate only
#   both            → generated + pre-provisioned
#   none            → no activity execution even after project activation
CANDIDATE_EXECUTION_SOURCE=

# =============================================================================
# Teardown / cleanup
# =============================================================================

# ENABLE_TEARDOWN:
#   true  (default) → teardown() deletes all resources created during the run
#   false           → resources are kept after the run (useful for debugging)
#
# NOTE: In load mode (LOAD_VUS > 1), individual VU resources are NOT auto-
# deleted because k6 cannot share mutable state across VUs. A per-run operator
# notice is printed to stdout with cleanup instructions. Set ENABLE_TEARDOWN=false
# and use a dedicated post-test cleanup script for large load runs.
ENABLE_TEARDOWN=true

# =============================================================================
# Project review
# =============================================================================
INCLUDE_PROJECT_REVIEW=false
ALLOW_SHARED_CANDIDATES=false
ALLOW_SHARED_REVIEW_TARGETS=false

# =============================================================================
# Booking / session propagation controls
# =============================================================================
ENFORCE_BOOKING=true
BOOKING_START_SETTLE_MS=3000
SESSION_START_RETRY_ATTEMPTS=3
SESSION_START_RETRY_DELAY_MS=2500

# =============================================================================
# Anam validation / resilience modes
# =============================================================================
# disabled   = Talent Intelligence OFF; browser must make zero Anam calls
# healthy    = Talent Intelligence ON; Anam remains reachable
# outage503  = Anam starts healthy; after initial engine+metrics success,
#              subsequent Anam HTTP calls receive 503
# network    = same timing as outage503, but subsequent HTTP is network-aborted
ANAM_MODE=disabled
ANUM_API_ENABLED=false

SIMULATE_ANAM_MID_SESSION_OUTAGE=false
ANAM_OUTAGE_MODE=503
ANAM_OUTAGE_AUTO_RECOVER=true
ANAM_OUTAGE_RECOVER_AFTER_MS=15000
OUTAGE_AUTO_COMPLETE_ACTIVITY=true
ANAM_REQUIRE_POST_RECOVERY_RETRY=false

# =============================================================================
# Browser (Playwright) controls
# =============================================================================
HEADLESS=true
# fake     = deterministic fake microphone (recommended for automated E2E)
# system   = use host microphone; requires HEADLESS=false
# disabled = no microphone permission
PLAYWRIGHT_MICROPHONE_MODE=fake
STEP_TIMEOUT_MS=20000
TIMER_MAX_WAIT_MIN=15
MAX_ACTIVITIES=10

# =============================================================================
# Optional review configuration
# =============================================================================
PROJECT_REVIEW_PROJECT_ID=
PROJECT_REVIEW_CANDIDATE_ID=
PROJECT_REVIEW_CANDIDATE_LIMIT=1
PROJECT_REVIEW_REASON=good
PROJECT_REVIEW_SCORE=
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=
CLIENT_ADMIN_USER_ID=

# =============================================================================
# Runner diagnostics
# =============================================================================
RUNNER_VERBOSE=false
