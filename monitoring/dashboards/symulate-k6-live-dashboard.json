{
  "title": "Symulate k6 Load Test - Live Monitoring",
  "uid": "symulate-k6-live",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users (VUs)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "SELECT mean(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Response Time p95 / p99 (overall)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "query": "SELECT percentile(\"value\", 99) AS \"p99\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "query": "SELECT mean(\"value\") * 100 AS \"error_rate\" FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 Response Time by Step (name tag)",
      "type": "timeseries",
      "description": "One line per logical step — Login, Create Client, Create Task, Submit Activity, etc. Tags come from utils/http.js -> tags:{name}.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval), \"name\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Checks Pass Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "query": "SELECT mean(\"value\") * 100 AS \"pass_rate\" FROM \"checks\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Data Received / Sent (bytes, by step)",
      "type": "timeseries",
      "description": "Custom byte counters from utils/http.js -> recvBytes/sentBytes, tagged per step.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "query": "SELECT non_negative_derivative(sum(\"value\"), 1s) FROM \"recv_bytes\" WHERE $timeFilter GROUP BY time($__interval), \"name\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Total Requests / Failures / Iterations (this run)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 31 },
      "targets": [
        {
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "query": "SELECT count(\"value\") FROM \"iterations\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ]
}
